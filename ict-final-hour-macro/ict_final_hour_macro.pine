//@version=6
indicator("ICT Final Hour — Iter 1: Dealing Range", shorttitle="FH Iter1 Range", overlay=true, max_lines_count=100, max_boxes_count=100, max_labels_count=100)

// =====================================================================================
// ITERATION 1 — FINAL HOUR DEALING RANGE ONLY
// -------------------------------------------------------------------------------------
// Scope for this iteration:
//   - Track the 3:00-3:50pm NY session high/low
//   - Draw it as a box + high/low lines directly on the candlestick pane (overlay=true)
//   - Lines stop extending at a configurable cutoff (default 4:25pm) instead of running
//     to the edge of the chart forever
// Explicitly NOT in this iteration: fib/STDV levels, equal highs/lows, SMT, raids,
// targets, signals. Those are later iterations per the project charter.
// =====================================================================================


// =====================================================================================
// INPUTS
// =====================================================================================
grpSession = "Session"
rangeSessionStr = input.session("1500-1530", "Final Hour Dealing Range (NY time)", group = grpSession)

grpDisplay = "Line Display"
displayEndStr = input.session("1625-1630", "Stop extending lines at (NY time)", group = grpDisplay)

grpTest = "Testing / Replay"
restrictDate = input.bool(false, "Restrict indicator to a single test date", group = grpTest)
testDate     = input.time(timestamp("2026-08-03 00:00 -0400"), "Test Date", group = grpTest)


// =====================================================================================
// TIME / SESSION HELPERS
// =====================================================================================
inRangeSession = not na(time(timeframe.period, rangeSessionStr, "America/New_York"))
inDisplayEnd   = not na(time(timeframe.period, displayEndStr, "America/New_York"))
reachedDisplayEnd = inDisplayEnd and not inDisplayEnd[1]

dateOK = not restrictDate or
     (year(time, "America/New_York")       == year(testDate, "America/New_York") and
      month(time, "America/New_York")      == month(testDate, "America/New_York") and
      dayofmonth(time, "America/New_York") == dayofmonth(testDate, "America/New_York"))


// =====================================================================================
// FINAL HOUR DEALING RANGE TRACKING
// =====================================================================================
var float rangeHigh    = na
var float rangeLow     = na
var int   rangeHighBar = na
var int   rangeLowBar  = na

newSession = inRangeSession and not inRangeSession[1]

if newSession and dateOK
    rangeHigh    := high
    rangeLow     := low
    rangeHighBar := bar_index
    rangeLowBar  := bar_index

if inRangeSession and not newSession and dateOK
    if high > rangeHigh
        rangeHigh    := high
        rangeHighBar := bar_index
    if low < rangeLow
        rangeLow    := low
        rangeLowBar := bar_index

sessionJustEnded = inRangeSession[1] and not inRangeSession

// small horizontal gap between where the lines end and where the label text starts,
// so the text never visually touches/overlaps the line regardless of chart zoom
labelGap = 3


// =====================================================================================
// DRAW DEALING RANGE BOX + LEVEL LINES (on the main candlestick pane — overlay=true above)
// =====================================================================================
var box   rangeBox   = na
var line  hiLine     = na
var line  loLine     = na
var label hiLabel    = na
var label loLabel    = na
var bool  rangeActive = false

if sessionJustEnded and dateOK
    box.delete(rangeBox)
    line.delete(hiLine)
    line.delete(loLine)
    label.delete(hiLabel)
    label.delete(loLabel)

    rangeBox := box.new(rangeHighBar, rangeHigh, bar_index, rangeLow,
         border_color = color.new(color.blue, 60), bgcolor = color.new(color.blue, 92),
         extend = extend.right)

    hiLine := line.new(rangeHighBar, rangeHigh, bar_index, rangeHigh,
         color = color.blue, width = 1, extend = extend.right)
    loLine := line.new(rangeLowBar, rangeLow, bar_index, rangeLow,
         color = color.blue, width = 1, extend = extend.right)

    // labels sit vertically centered right on the line (transparent background, just the
    // colored text with a small connector dash) — matches the reference style; they'll
    // track to the right edge below and freeze at the display cutoff
    hiLabel := label.new(bar_index + labelGap, rangeHigh, "Final Hour Dealing Range High",
         style = label.style_label_left, color = color.new(color.blue, 100),
         textcolor = color.blue, size = size.small)
    loLabel := label.new(bar_index + labelGap, rangeLow, "Final Hour Dealing Range Low",
         style = label.style_label_left, color = color.new(color.blue, 100),
         textcolor = color.blue, size = size.small)

    rangeActive := true

// keep the labels tracking a few bars ahead of the current (rightmost) bar, same as the
// extend.right lines, until the display cutoff freezes everything in place
if rangeActive and dateOK and not reachedDisplayEnd
    if not na(hiLabel)
        label.set_x(hiLabel, bar_index + labelGap)
    if not na(loLabel)
        label.set_x(loLabel, bar_index + labelGap)


// =====================================================================================
// STOP EXTENDING LINES AT THE DISPLAY CUTOFF (default 4:25pm NY)
// =====================================================================================
if reachedDisplayEnd and dateOK
    if not na(rangeBox)
        box.set_right(rangeBox, bar_index)
        box.set_extend(rangeBox, extend.none)
    if not na(hiLine)
        line.set_x2(hiLine, bar_index)
        line.set_extend(hiLine, extend.none)
    if not na(loLine)
        line.set_x2(loLine, bar_index)
        line.set_extend(loLine, extend.none)
    if not na(hiLabel)
        label.set_x(hiLabel, bar_index + labelGap)
    if not na(loLabel)
        label.set_x(loLabel, bar_index + labelGap)
    rangeActive := false
