// @version=5
indicator("Increment 1 - Bar Counter", overlay=true)

// Just counts confirmed bars on the chart. If this number isn't climbing
// as new bars close, nothing downstream can work either.

var int barCount = 0

if barstate.isconfirmed
    barCount += 1

var table dbgTbl = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast
    table.cell(dbgTbl, 0, 0, "chart tf", text_color=color.white)
    table.cell(dbgTbl, 1, 0, timeframe.period, text_color=color.white)
    table.cell(dbgTbl, 0, 1, "confirmed bars seen", text_color=color.white)
    table.cell(dbgTbl, 1, 1, str.tostring(barCount), text_color=color.white)
    table.cell(dbgTbl, 0, 2, "current bar time (NY)", text_color=color.white)
    nyH = hour(time, "America/New_York")
    nyM = minute(time, "America/New_York")
    table.cell(dbgTbl, 1, 2, str.tostring(nyH) + ":" + str.tostring(nyM), text_color=color.white)
