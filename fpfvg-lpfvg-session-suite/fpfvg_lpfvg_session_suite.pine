// @version=5
indicator("FPFVG / LPFVG Session Suite", overlay=true, max_boxes_count=200, max_labels_count=200)

// Scales up the PROVEN Increment 3/4 pattern (first-FVG-found-wins, per-day
// reset, dynamic 10-bar-ahead extension, freeze at cap) to all 11 "simple"
// sessions — the ones with NO override and NO shared LPFVG window.
// No 9am:15/:30/:45, 10am:15/:30/:45, Tokyo:15/:30/:45, or any LPFVG yet —
// those come in later batches.

grpMid = "Midnight"
showMidnight = input.bool(true, "Show Midnight group", group=grpMid)
i_Midnight   = input.bool(true, "Midnight FVG", group=grpMid)

grp1am = "1am"
show1am = input.bool(true, "Show 1am group", group=grp1am)
i_1am   = input.bool(true, "1am FVG", group=grp1am)

grp2am = "2am"
show2am = input.bool(true, "Show 2am group", group=grp2am)
i_2am   = input.bool(true, "2am FVG", group=grp2am)

grp3am = "3am"
show3am = input.bool(true, "Show 3am group", group=grp3am)
i_3am   = input.bool(true, "3am FVG", group=grp3am)

grp6am = "6am"
show6am = input.bool(true, "Show 6am group", group=grp6am)
i_6am_F = input.bool(true, "6am First", group=grp6am)
i_6am_L = input.bool(true, "6am Last", group=grp6am)

grp7am = "7am"
show7am = input.bool(true, "Show 7am group", group=grp7am)
i_7am   = input.bool(true, "7am FVG", group=grp7am)

grp8am = "8am"
show8am  = input.bool(true, "Show 8am group", group=grp8am)
i_8am_00 = input.bool(true, "8am FVG", group=grp8am)
i_8am_30 = input.bool(true, "8am :30", group=grp8am)

grp9am = "9am"
show9am  = input.bool(true, "Show 9am group", group=grp9am)
i_9am_00 = input.bool(true, "9am FVG", group=grp9am)
i_9am_15 = input.bool(true, "9am :15", group=grp9am)
i_9am_30 = input.bool(true, "9am :30", group=grp9am)
i_9am_45 = input.bool(true, "9am :45", group=grp9am)
i_9am_LP = input.bool(true, "9am Last", group=grp9am)

grp10am = "10am"
show10am  = input.bool(true, "Show 10am group", group=grp10am)
i_10am_00 = input.bool(true, "10am FVG", group=grp10am)
i_10am_15 = input.bool(true, "10am :15", group=grp10am)
i_10am_30 = input.bool(true, "10am :30", group=grp10am)
i_10am_45 = input.bool(true, "10am :45", group=grp10am)
i_10am_LP = input.bool(true, "10am Last", group=grp10am)

grp6pm = "6pm"
show6pm = input.bool(true, "Show 6pm group", group=grp6pm)
i_6pm_F = input.bool(true, "6pm First", group=grp6pm)
i_6pm_L = input.bool(true, "6pm Last", group=grp6pm)

grp7pm = "7pm"
show7pm = input.bool(true, "Show 7pm group", group=grp7pm)
i_7pm_F = input.bool(true, "7pm First", group=grp7pm)
i_7pm_L = input.bool(true, "7pm Last", group=grp7pm)

grpTokyo = "Tokyo (8pm)"
showTokyo  = input.bool(true, "Show Tokyo group", group=grpTokyo)
i_Tokyo_00 = input.bool(true, "Tokyo FVG", group=grpTokyo)
i_Tokyo_15 = input.bool(true, "Tokyo :15", group=grpTokyo)
i_Tokyo_30 = input.bool(true, "Tokyo :30", group=grpTokyo)
i_Tokyo_45 = input.bool(true, "Tokyo :45", group=grpTokyo)
i_Tokyo_LP = input.bool(true, "Tokyo Last", group=grpTokyo)

grp10pm = "10pm"
show10pm = input.bool(true, "Show 10pm group", group=grp10pm)
i_10pm   = input.bool(true, "10pm FVG", group=grp10pm)

type SessCfg
    string label
    int startH
    int startM
    int winMin
    bool show
    int extType   // 0 = fixed NY clock time, 1 = +24h, 2 = +21 days
    int extH
    int extM
    bool isLast    // true = LPFVG-style: always take the LATEST match in the window, not just the first
    bool allowOverride  // true = keep the biggest-gap match found within the window, not just the first
    bool isFortyFive    // true = this is a :45 tracker (gets the special :54 exception)
    bool isLPshared      // true = this is an LPFVG that shares its window with a :45 tracker

type SessState
    box b = na
    label lb = na
    line mid = na
    bool active = false
    bool finalized = false
    int day = na
    int left = na
    float top = na
    float bot = na
    float gapSize = na
    int extTarget = na

var SessCfg[] cfgs = array.new<SessCfg>()
var SessState[] states = array.new<SessState>()

f_add(_label, _sh, _sm, _win, _show, _extType, _eh, _em, _isLast, _ovr, _is45, _isLP) =>
    array.push(cfgs, SessCfg.new(_label, _sh, _sm, _win, _show, _extType, _eh, _em, _isLast, _ovr, _is45, _isLP))
    array.push(states, SessState.new())

if barstate.isfirst
    f_add("FPFVG Midnight", 0, 0, 15, showMidnight and i_Midnight, 1, 0, 0, false, false, false, false)
    f_add("FPFVG 1am", 1, 0, 15, show1am and i_1am, 0, 10, 0, false, false, false, false)
    f_add("FPFVG 2am", 2, 0, 15, show2am and i_2am, 0, 10, 0, false, false, false, false)
    f_add("FPFVG 3am", 3, 0, 15, show3am and i_3am, 0, 10, 0, false, false, false, false)
    f_add("FPFVG 6am", 6, 0, 60, show6am and i_6am_F, 0, 11, 0, false, false, false, false)
    f_add("LPFVG 6am", 6, 0, 60, show6am and i_6am_L, 0, 11, 0, true, false, false, false)
    f_add("FPFVG 7am", 7, 0, 15, show7am and i_7am, 0, 10, 0, false, false, false, false)
    f_add("FPFVG 8am", 8, 0, 15, show8am and i_8am_00, 0, 10, 0, false, false, false, false)
    f_add("FPFVG 8am :30", 8, 30, 15, show8am and i_8am_30, 0, 10, 0, false, false, false, false)
    f_add("FPFVG 9am", 9, 0, 15, show9am and i_9am_00, 0, 10, 0, false, false, false, false)
    f_add("FPFVG 9am :15", 9, 15, 10, show9am and i_9am_15, 0, 10, 0, false, true, false, false)
    f_add("FPFVG 9am :30", 9, 30, 10, show9am and i_9am_30, 1, 0, 0, false, true, false, false)
    f_add("FPFVG 9am :45", 9, 45, 5, show9am and i_9am_45, 0, 10, 0, false, true, true, false)
    f_add("LPFVG 9am", 9, 54, 6, show9am and i_9am_LP, 0, 10, 0, true, false, false, true)
    f_add("FPFVG 10am", 10, 0, 15, show10am and i_10am_00, 1, 0, 0, false, false, false, false)
    f_add("FPFVG 10am :15", 10, 15, 10, show10am and i_10am_15, 0, 11, 0, false, true, false, false)
    f_add("FPFVG 10am :30", 10, 30, 10, show10am and i_10am_30, 0, 11, 0, false, true, false, false)
    f_add("FPFVG 10am :45", 10, 45, 5, show10am and i_10am_45, 0, 11, 0, false, true, true, false)
    f_add("LPFVG 10am", 10, 54, 6, show10am and i_10am_LP, 0, 11, 0, true, false, false, true)
    f_add("FPFVG 6pm", 18, 0, 60, show6pm and i_6pm_F, 0, 4, 0, false, false, false, false)
    f_add("LPFVG 6pm", 18, 0, 60, show6pm and i_6pm_L, 0, 4, 0, true, false, false, false)
    f_add("FPFVG 7pm", 19, 0, 60, show7pm and i_7pm_F, 0, 23, 0, false, false, false, false)
    f_add("LPFVG 7pm", 19, 0, 60, show7pm and i_7pm_L, 0, 23, 0, true, false, false, false)
    f_add("FPFVG Tokyo", 20, 0, 15, showTokyo and i_Tokyo_00, 0, 6, 0, false, false, false, false)
    f_add("FPFVG Tokyo :15", 20, 15, 10, showTokyo and i_Tokyo_15, 0, 0, 0, false, true, false, false)
    f_add("FPFVG Tokyo :30", 20, 30, 10, showTokyo and i_Tokyo_30, 0, 6, 0, false, true, false, false)
    f_add("FPFVG Tokyo :45", 20, 45, 5, showTokyo and i_Tokyo_45, 0, 0, 0, false, true, true, false)
    f_add("LPFVG Tokyo", 20, 54, 6, showTokyo and i_Tokyo_LP, 0, 6, 0, true, false, false, true)
    f_add("FPFVG 10pm", 22, 0, 15, show10pm and i_10pm, 0, 6, 0, false, false, false, false)

var int barCount = 0
bull = false
bear = false

if barstate.isconfirmed
    barCount += 1
    if barCount >= 3
        h1 = high[2]
        l1 = low[2]
        h3 = high[0]
        l3 = low[0]
        bull := l3 > h1
        bear := h3 < l1

        if bull or bear
            originTime = time[2]
            nyH = hour(originTime, "America/New_York")
            nyM = minute(originTime, "America/New_York")
            nyY = year(originTime, "America/New_York")
            nyMo = month(originTime, "America/New_York")
            nyD = dayofmonth(originTime, "America/New_York")
            dayKey = nyY * 372 + nyMo * 31 + nyD
            momNY = nyH * 60 + nyM
            gTop = bull ? l3 : l1
            gBot = bull ? h1 : h3
            gapSizeNow = gTop - gBot

            for s = 0 to array.size(cfgs) - 1
                cfg = array.get(cfgs, s)
                st = array.get(states, s)
                if cfg.show
                    winStart = cfg.startH * 60 + cfg.startM
                    winEnd = winStart + cfg.winMin
                    inWin = momNY >= winStart and momNY < winEnd
                    isNewDay = na(st.day) or dayKey != st.day

                    shouldTake = false
                    if inWin
                        if isNewDay
                            shouldTake := true
                        else if not st.active
                            shouldTake := true
                        else if cfg.isLast
                            shouldTake := true
                        else if cfg.allowOverride and gapSizeNow > st.gapSize
                            shouldTake := true

                    if shouldTake
                        // if we're replacing an existing box (LPFVG overwrite or a
                        // bigger-displacement override within the same day), delete the
                        // old drawing first so it doesn't linger
                        if st.active and not isNewDay and not na(st.b)
                            box.delete(st.b)
                            line.delete(st.mid)
                            label.delete(st.lb)
                        st.active := true
                        st.finalized := false
                        st.day := dayKey
                        st.left := originTime
                        st.top := gTop
                        st.bot := gBot
                        st.gapSize := gapSizeNow
                        st.b := na
                        // extension target
                        if cfg.extType == 1
                            st.extTarget := originTime + 86400000
                        else if cfg.extType == 2
                            st.extTarget := originTime + 21 * 86400000
                        else
                            base = timestamp("America/New_York", nyY, nyMo, nyD, cfg.extH, cfg.extM)
                            st.extTarget := cfg.extH <= nyH ? base + 86400000 : base

                    // Exception: for the :45 trackers specifically, a bigger-displacement
                    // FVG whose origin lands exactly at :54 overrides the :45 pick even
                    // though it's outside the normal 45-50 seek window. But :54 is also
                    // where LPFVG's own window (54-59) begins — so whenever the paired
                    // LPFVG tracker is enabled, we defer to it entirely (it'll naturally
                    // claim that same candle via its own window logic below, and gets the
                    // "Last" label). This override only fires as a fallback when LPFVG is
                    // toggled off for that hour.
                    if cfg.isFortyFive and not isNewDay and st.day == dayKey
                        is54 = momNY == (cfg.startH * 60 + 54)
                        if is54 and (not st.active or gapSizeNow > st.gapSize)
                            lpEnabled = false
                            for p = 0 to array.size(cfgs) - 1
                                pcfg = array.get(cfgs, p)
                                if pcfg.isLPshared and pcfg.startH == cfg.startH and pcfg.show
                                    lpEnabled := true
                            if not lpEnabled
                                if st.active and not na(st.b)
                                    box.delete(st.b)
                                    line.delete(st.mid)
                                    label.delete(st.lb)
                                st.active := true
                                st.finalized := false
                                st.day := dayKey
                                st.left := originTime
                                st.top := gTop
                                st.bot := gBot
                                st.gapSize := gapSizeNow
                                st.b := na
                                if cfg.extType == 1
                                    st.extTarget := originTime + 86400000
                                else if cfg.extType == 2
                                    st.extTarget := originTime + 21 * 86400000
                                else
                                    base2 = timestamp("America/New_York", nyY, nyMo, nyD, cfg.extH, cfg.extM)
                                    st.extTarget := cfg.extH <= nyH ? base2 + 86400000 : base2

lookAheadBars = 10
labelGap = 3   // small time-gap so label text doesn't touch the line, same convention as the dealing range script
gapMs = labelGap * timeframe.in_seconds(timeframe.period) * 1000

if barstate.isconfirmed or barstate.isrealtime
    for s = 0 to array.size(cfgs) - 1
        cfg = array.get(cfgs, s)
        st = array.get(states, s)
        if cfg.show and st.active and not st.finalized
            rightEdge = time + lookAheadBars * (time - time[1])
            capped = not na(st.extTarget) and rightEdge >= st.extTarget
            drawRight = capped ? st.extTarget : rightEdge
            midPrice = (st.top + st.bot) / 2

            if na(st.b)
                st.b := box.new(left=st.left, top=st.top, right=drawRight, bottom=st.bot,
                     border_color=color.new(#eeec82, 25), bgcolor=color.new(#eeec82, 80),
                     border_width=1, xloc=xloc.bar_time)
                st.mid := line.new(x1=st.left, y1=midPrice, x2=drawRight, y2=midPrice,
                     color=color.new(#eeec82, 25), style=line.style_dashed, width=1, xloc=xloc.bar_time)
                st.lb := label.new(x=drawRight + gapMs, y=midPrice, text=cfg.label, style=label.style_label_left,
                     color=color.new(color.black, 100), textcolor=color.new(#eeec82, 0), size=size.small, xloc=xloc.bar_time)
            else
                box.set_right(st.b, drawRight)
                line.set_x2(st.mid, drawRight)
                label.set_x(st.lb, drawRight + gapMs)

            if capped
                st.finalized := true
