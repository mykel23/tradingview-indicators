// @version=5
indicator("Increment 6 - Batch 3 (+ Override Quarters)", overlay=true, max_boxes_count=200, max_labels_count=200)

// Scales up the PROVEN Increment 3/4 pattern (first-FVG-found-wins, per-day
// reset, dynamic 10-bar-ahead extension, freeze at cap) to all 11 "simple"
// sessions — the ones with NO override and NO shared LPFVG window.
// No 9am:15/:30/:45, 10am:15/:30/:45, Tokyo:15/:30/:45, or any LPFVG yet —
// those come in later batches.

grp = "Session Groups"
showMidnight = input.bool(true, "Midnight (12am)", group=grp)
show1am      = input.bool(true, "1am", group=grp)
show2am      = input.bool(true, "2am", group=grp)
show3am      = input.bool(true, "3am", group=grp)
show6am      = input.bool(true, "6am", group=grp)
show7am      = input.bool(true, "7am", group=grp)
show8am      = input.bool(true, "8am", group=grp)
show9am      = input.bool(true, "9am", group=grp)
show10am     = input.bool(true, "10am", group=grp)
show6pm      = input.bool(true, "6pm", group=grp)
show7pm      = input.bool(true, "7pm", group=grp)
showTokyo    = input.bool(true, "Tokyo (8pm)", group=grp)
show10pm     = input.bool(true, "10pm", group=grp)

type SessCfg
    string label
    int startH
    int startM
    int winMin
    bool show
    int extType   // 0 = fixed NY clock time, 1 = +24h, 2 = +21 days
    int extH
    int extM
    bool isLast    // true = LPFVG-style: always take the LATEST match in the window, not just the first
    bool allowOverride  // true = keep the biggest-gap match found within the window, not just the first

type SessState
    box b = na
    label lb = na
    line mid = na
    bool active = false
    bool finalized = false
    int day = na
    int left = na
    float top = na
    float bot = na
    float gapSize = na
    int extTarget = na

var SessCfg[] cfgs = array.new<SessCfg>()
var SessState[] states = array.new<SessState>()

f_add(_label, _sh, _sm, _win, _show, _extType, _eh, _em, _isLast, _ovr) =>
    array.push(cfgs, SessCfg.new(_label, _sh, _sm, _win, _show, _extType, _eh, _em, _isLast, _ovr))
    array.push(states, SessState.new())

if barstate.isfirst
    f_add("FPFVG Midnight", 0, 0, 15, showMidnight, 1, 0, 0, false, false)      // +24h
    f_add("FPFVG 1am", 1, 0, 15, show1am, 0, 10, 0, false, false)               // until 10am
    f_add("FPFVG 2am", 2, 0, 15, show2am, 0, 10, 0, false, false)
    f_add("FPFVG 3am", 3, 0, 15, show3am, 0, 10, 0, false, false)
    f_add("FPFVG 6am", 6, 0, 60, show6am, 0, 11, 0, false, false)                // full hour, until 11am
    f_add("LPFVG 6am", 6, 0, 60, show6am, 0, 11, 0, true, false)                 // full hour, until 11am
    f_add("FPFVG 7am", 7, 0, 15, show7am, 0, 10, 0, false, false)
    f_add("FPFVG 8am", 8, 0, 15, show8am, 0, 10, 0, false, false)
    f_add("FPFVG 8am :30", 8, 30, 15, show8am, 0, 10, 0, false, false)
    f_add("FPFVG 9am", 9, 0, 15, show9am, 0, 10, 0, false, false)
    f_add("FPFVG 9am :15", 9, 15, 10, show9am, 0, 10, 0, false, true)            // seeks to :25
    f_add("FPFVG 9am :30", 9, 30, 10, show9am, 1, 0, 0, false, true)             // seeks to :40, +24h ext
    f_add("FPFVG 9am :45", 9, 45, 5, show9am, 0, 10, 0, false, true)             // seeks to :50
    f_add("FPFVG 10am", 10, 0, 15, show10am, 1, 0, 0, false, false)             // +24h
    f_add("FPFVG 10am :15", 10, 15, 10, show10am, 0, 11, 0, false, true)        // seeks to :25
    f_add("FPFVG 10am :30", 10, 30, 10, show10am, 0, 11, 0, false, true)        // seeks to :40
    f_add("FPFVG 10am :45", 10, 45, 5, show10am, 0, 11, 0, false, true)         // seeks to :50
    f_add("FPFVG 6pm", 18, 0, 60, show6pm, 0, 4, 0, false, false)                // full hour, until 4am
    f_add("LPFVG 6pm", 18, 0, 60, show6pm, 0, 4, 0, true, false)
    f_add("FPFVG 7pm", 19, 0, 60, show7pm, 0, 23, 0, false, false)               // full hour, until 11pm
    f_add("LPFVG 7pm", 19, 0, 60, show7pm, 0, 23, 0, true, false)
    f_add("FPFVG Tokyo", 20, 0, 15, showTokyo, 0, 6, 0, false, false)       // until 6am
    f_add("FPFVG Tokyo :15", 20, 15, 10, showTokyo, 0, 0, 0, false, true)   // seeks to :25, until 12am
    f_add("FPFVG Tokyo :30", 20, 30, 10, showTokyo, 0, 6, 0, false, true)   // seeks to :40, until 6am
    f_add("FPFVG Tokyo :45", 20, 45, 5, showTokyo, 0, 0, 0, false, true)    // seeks to :50, until 12am
    f_add("FPFVG 10pm", 22, 0, 15, show10pm, 0, 6, 0, false, false)             // until 6am

var int barCount = 0
bull = false
bear = false

if barstate.isconfirmed
    barCount += 1
    if barCount >= 3
        h1 = high[2]
        l1 = low[2]
        h3 = high[0]
        l3 = low[0]
        bull := l3 > h1
        bear := h3 < l1

        if bull or bear
            originTime = time[2]
            nyH = hour(originTime, "America/New_York")
            nyM = minute(originTime, "America/New_York")
            nyY = year(originTime, "America/New_York")
            nyMo = month(originTime, "America/New_York")
            nyD = dayofmonth(originTime, "America/New_York")
            dayKey = nyY * 372 + nyMo * 31 + nyD
            momNY = nyH * 60 + nyM
            gTop = bull ? l3 : l1
            gBot = bull ? h1 : h3
            gapSizeNow = gTop - gBot

            for s = 0 to array.size(cfgs) - 1
                cfg = array.get(cfgs, s)
                st = array.get(states, s)
                if cfg.show
                    winStart = cfg.startH * 60 + cfg.startM
                    winEnd = winStart + cfg.winMin
                    inWin = momNY >= winStart and momNY < winEnd
                    isNewDay = na(st.day) or dayKey != st.day

                    shouldTake = false
                    if inWin
                        if isNewDay
                            shouldTake := true
                        else if not st.active
                            shouldTake := true
                        else if cfg.isLast
                            shouldTake := true
                        else if cfg.allowOverride and gapSizeNow > st.gapSize
                            shouldTake := true

                    if shouldTake
                        // if we're replacing an existing box (LPFVG overwrite or a
                        // bigger-displacement override within the same day), delete the
                        // old drawing first so it doesn't linger
                        if st.active and not isNewDay and not na(st.b)
                            box.delete(st.b)
                            line.delete(st.mid)
                            label.delete(st.lb)
                        st.active := true
                        st.finalized := false
                        st.day := dayKey
                        st.left := originTime
                        st.top := gTop
                        st.bot := gBot
                        st.gapSize := gapSizeNow
                        st.b := na
                        // extension target
                        if cfg.extType == 1
                            st.extTarget := originTime + 86400000
                        else if cfg.extType == 2
                            st.extTarget := originTime + 21 * 86400000
                        else
                            base = timestamp("America/New_York", nyY, nyMo, nyD, cfg.extH, cfg.extM)
                            st.extTarget := cfg.extH <= nyH ? base + 86400000 : base

lookAheadBars = 10
labelGap = 3   // small time-gap so label text doesn't touch the line, same convention as the dealing range script
gapMs = labelGap * timeframe.in_seconds(timeframe.period) * 1000

if barstate.isconfirmed or barstate.isrealtime
    for s = 0 to array.size(cfgs) - 1
        cfg = array.get(cfgs, s)
        st = array.get(states, s)
        if cfg.show and st.active and not st.finalized
            rightEdge = time + lookAheadBars * (time - time[1])
            capped = not na(st.extTarget) and rightEdge >= st.extTarget
            drawRight = capped ? st.extTarget : rightEdge
            midPrice = (st.top + st.bot) / 2

            if na(st.b)
                st.b := box.new(left=st.left, top=st.top, right=drawRight, bottom=st.bot,
                     border_color=color.new(#eeec82, 25), bgcolor=color.new(#eeec82, 80),
                     border_width=1, xloc=xloc.bar_time)
                st.mid := line.new(x1=st.left, y1=midPrice, x2=drawRight, y2=midPrice,
                     color=color.new(#eeec82, 25), style=line.style_dashed, width=1, xloc=xloc.bar_time)
                st.lb := label.new(x=drawRight + gapMs, y=midPrice, text=cfg.label, style=label.style_label_left,
                     color=color.new(color.black, 100), textcolor=color.new(#eeec82, 0), size=size.small, xloc=xloc.bar_time)
            else
                box.set_right(st.b, drawRight)
                line.set_x2(st.mid, drawRight)
                label.set_x(st.lb, drawRight + gapMs)

            if capped
                st.finalized := true

var table dbgTbl = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast
    activeCount = 0
    for s = 0 to array.size(states) - 1
        if array.get(states, s).active
            activeCount += 1
    table.cell(dbgTbl, 0, 0, "chart tf", text_color=color.white)
    table.cell(dbgTbl, 1, 0, timeframe.period, text_color=color.white)
    table.cell(dbgTbl, 0, 1, "confirmed bars seen", text_color=color.white)
    table.cell(dbgTbl, 1, 1, str.tostring(barCount), text_color=color.white)
    table.cell(dbgTbl, 0, 2, "sessions active", text_color=color.white)
    table.cell(dbgTbl, 1, 2, str.tostring(activeCount) + " / " + str.tostring(array.size(cfgs)), text_color=color.white)
