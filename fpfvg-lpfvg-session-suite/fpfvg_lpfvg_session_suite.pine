// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// @version=5
indicator("FPFVG / LPFVG Session Suite", overlay=true, max_boxes_count=500, max_labels_count=500, dynamic_requests=true)

// =====================================================================================
// ASSUMPTIONS / NOTES (read before using — flag anything that doesn't match your intent)
// =====================================================================================
// 1. FVG detection ALWAYS runs on native 1-minute data (via request.security_lower_tf),
//    regardless of the chart's timeframe. Boxes shown on a 5m/15m chart are the same
//    1m-native FVGs, not FVGs recomputed from that chart's own bars.
// 2. "Displacement" (used for the dynamic :15/:30/:45 override) is measured as the gap
//    size (top of gap - bottom of gap). If a bigger-gap FVG forms later in the same
//    seek window, it replaces the earlier one for that slot.
// 3. :00 quarters (and all single-tracker sessions: 1am/2am/3am/6am(first)/7am/8am/
//    10pm/Midnight/Tokyo :00) use a plain 15-min window, FIRST FVG found wins, no
//    displacement override (override was only specified for :15/:30/:45).
// 4. First/last PAIR sessions (6am, 7pm, 6pm) scan the FULL hour as one window; FPFVG
//    = first FVG in that hour, LPFVG = last FVG in that hour. No override on these.
// 5. :45 and LPFVG (for 9am/10am/Tokyo, the 5-tracker hours) share the SAME window
//    (45–50), scanned independently: FPFVG:45 = first (with override), LPFVG = last.
//    General override rule: if the window produces only ONE FVG (so it's serving as
//    both), and a further FVG forms right at the :50 boundary, that boundary FVG
//    REPLACES FPFVG:45 and becomes the LPFVG. This is the trickiest rule in the spec —
//    test it against real examples and flag any mismatch.
// 6. Extension: every active (non-finalized) box's right edge is redrawn each bar to
//    (bar_index + 10) on the CHART's timeframe, until the box reaches its session's
//    final cap (a fixed NY clock time, +24h, or +21 days from formation), at which
//    point it freezes at that final edge.
// 7. Both bullish and bearest FVGs are tracked identically — no visual distinction yet.
// =====================================================================================

// ---------------------------- Style ----------------------------
var color FVG_COLOR = color.new(#eeec82, 80)   // 20% opacity fill = 80% transparency
var color FVG_BORDER = color.new(#eeec82, 25)  // 75% opacity border = 25% transparency

// ---------------------------- Master group toggles ----------------------------
grp = "Session Groups"
showMidnight = input.bool(true, "Midnight (12am)", group=grp)
show1am      = input.bool(true, "1am", group=grp)
show2am      = input.bool(true, "2am", group=grp)
show3am      = input.bool(true, "3am", group=grp)
show6am      = input.bool(true, "6am", group=grp)
show7am      = input.bool(true, "7am", group=grp)
show8am      = input.bool(true, "8am", group=grp)
show9am      = input.bool(true, "9am", group=grp)
show10am     = input.bool(true, "10am", group=grp)
show6pm      = input.bool(true, "6pm", group=grp)
show7pm      = input.bool(true, "7pm", group=grp)
showTokyo    = input.bool(true, "Tokyo (8pm)", group=grp)
show10pm     = input.bool(true, "10pm", group=grp)

// ---------------------------- Individual FVG toggles ----------------------------
grp2 = "Individual FVGs"
i_Midnight   = input.bool(true, "Midnight", group=grp2)
i_1am        = input.bool(true, "1am", group=grp2)
i_2am        = input.bool(true, "2am", group=grp2)
i_3am        = input.bool(true, "3am", group=grp2)
i_6am_F      = input.bool(true, "6am First", group=grp2)
i_6am_L      = input.bool(true, "6am Last", group=grp2)
i_7am        = input.bool(true, "7am", group=grp2)
i_8am_00     = input.bool(true, "8am", group=grp2)
i_8am_30     = input.bool(true, "8am :30", group=grp2)
i_9am_00     = input.bool(true, "9am :00", group=grp2)
i_9am_15     = input.bool(true, "9am :15", group=grp2)
i_9am_30     = input.bool(true, "9am :30", group=grp2)
i_9am_45     = input.bool(true, "9am :45", group=grp2)
i_9am_LP     = input.bool(true, "9am LPFVG", group=grp2)
i_10am_00    = input.bool(true, "10am First", group=grp2)
i_10am_15    = input.bool(true, "10am :15", group=grp2)
i_10am_30    = input.bool(true, "10am :30", group=grp2)
i_10am_45    = input.bool(true, "10am :45", group=grp2)
i_10am_LP    = input.bool(true, "10am LPFVG", group=grp2)
i_6pm_F      = input.bool(true, "6pm First", group=grp2)
i_6pm_L      = input.bool(true, "6pm Last", group=grp2)
i_7pm_F      = input.bool(true, "7pm First", group=grp2)
i_7pm_L      = input.bool(true, "7pm Last", group=grp2)
i_Tokyo_00   = input.bool(true, "Tokyo :00", group=grp2)
i_Tokyo_15   = input.bool(true, "Tokyo :15", group=grp2)
i_Tokyo_30   = input.bool(true, "Tokyo :30", group=grp2)
i_Tokyo_45   = input.bool(true, "Tokyo :45", group=grp2)
i_Tokyo_LP   = input.bool(true, "Tokyo LPFVG", group=grp2)
i_10pm       = input.bool(true, "10pm", group=grp2)

// ---------------------------- Session config type ----------------------------
type SessCfg
    string label
    int startH
    int startM
    int winMin        // seek window length in minutes
    bool isLast        // true => track LAST fvg in window (LPFVG), false => track FIRST
    bool allowOverride // dynamic bigger-displacement override within window
    bool show
    int extType        // 0 = fixed NY clock time, 1 = +24h from formation, 2 = +21 days
    int extH
    int extM
    bool isFortyFive   // flags the :45 slot (for the special LP-override-of-:45 rule)
    bool isLPshared    // flags the LP slot that shares window w/ a :45 slot

type SessState
    box b = na
    label lb = na
    int formTime = na
    int lastFoundTime = na
    int extTarget = na
    float gapTop = na
    float gapBot = na
    bool bull = na
    bool finalized = false
    bool active = false

var SessCfg[] cfgs = array.new<SessCfg>()
var SessState[] states = array.new<SessState>()

f_add(_label, _sh, _sm, _win, _isLast, _ovr, _show, _extType, _eh, _em, _is45, _isLPshared) =>
    array.push(cfgs, SessCfg.new(_label, _sh, _sm, _win, _isLast, _ovr, _show, _extType, _eh, _em, _is45, _isLPshared))
    array.push(states, SessState.new())

if barstate.isfirst
    // extType: 0=fixed clock, 1=+24h, 2=+21days
    // --- Midnight (24h ext) ---
    f_add("FPFVG Midnight", 0, 0, 15, false, false, showMidnight and i_Midnight, 1, 0, 0, false, false)
    // --- 1am/2am/3am (until 10am) ---
    f_add("FPFVG 1am", 1, 0, 15, false, false, show1am and i_1am, 0, 10, 0, false, false)
    f_add("FPFVG 2am", 2, 0, 15, false, false, show2am and i_2am, 0, 10, 0, false, false)
    f_add("FPFVG 3am", 3, 0, 15, false, false, show3am and i_3am, 0, 10, 0, false, false)
    // --- 6am first/last (until 11am) ---
    f_add("FPFVG 6am", 6, 0, 60, false, false, show6am and i_6am_F, 0, 11, 0, false, false)
    f_add("LPFVG 6am", 6, 0, 60, true, false, show6am and i_6am_L, 0, 11, 0, false, false)
    // --- 7am (until 10am) ---
    f_add("FPFVG 7am", 7, 0, 15, false, false, show7am and i_7am, 0, 10, 0, false, false)
    // --- 8am :00 and :30 (until 10am) ---
    f_add("FPFVG 8am", 8, 0, 15, false, false, show8am and i_8am_00, 0, 10, 0, false, false)
    f_add("FPFVG 8am :30", 8, 30, 15, false, false, show8am and i_8am_30, 0, 10, 0, false, false)
    // --- 9am group ---
    f_add("FPFVG 9am :00", 9, 0, 15, false, false, show9am and i_9am_00, 0, 10, 0, false, false)
    f_add("FPFVG 9am :15", 9, 15, 10, false, true, show9am and i_9am_15, 0, 10, 0, false, false)   // seeks to :25
    f_add("FPFVG 9am :30", 9, 30, 24, false, true, show9am and i_9am_30, 1, 0, 0, false, false)      // seeks to :40 (24h ext special case)
    f_add("FPFVG 9am :45", 9, 45, 5, false, true, show9am and i_9am_45, 0, 10, 0, true, false)       // seeks to :50
    f_add("LPFVG 9am", 9, 45, 5, true, false, show9am and i_9am_LP, 0, 10, 0, false, true)           // shares :45 window
    // --- 10am group ---
    f_add("FPFVG 10am", 10, 0, 15, false, false, show10am and i_10am_00, 1, 0, 0, false, false)      // 24h ext
    f_add("FPFVG 10am :15", 10, 15, 10, false, true, show10am and i_10am_15, 0, 11, 0, false, false) // seeks to :25
    f_add("FPFVG 10am :30", 10, 30, 10, false, true, show10am and i_10am_30, 0, 11, 0, false, false) // seeks to :40
    f_add("FPFVG 10am :45", 10, 45, 5, false, true, show10am and i_10am_45, 0, 11, 0, true, false)   // seeks to :50
    f_add("LPFVG 10am", 10, 45, 5, true, false, show10am and i_10am_LP, 0, 11, 0, false, true)       // shares :45 window
    // --- 6pm first/last (until 4am next day) ---
    f_add("FPFVG 6pm", 18, 0, 60, false, false, show6pm and i_6pm_F, 0, 4, 0, false, false)
    f_add("LPFVG 6pm", 18, 0, 60, true, false, show6pm and i_6pm_L, 0, 4, 0, false, false)
    // --- 7pm first/last (until 11pm) ---
    f_add("FPFVG 7pm", 19, 0, 60, false, false, show7pm and i_7pm_F, 0, 23, 0, false, false)
    f_add("LPFVG 7pm", 19, 0, 60, true, false, show7pm and i_7pm_L, 0, 23, 0, false, false)
    // --- Tokyo (8pm) group ---
    f_add("FPFVG Tokyo :00", 20, 0, 15, false, false, showTokyo and i_Tokyo_00, 0, 6, 0, false, false)   // until 6am
    f_add("FPFVG Tokyo :15", 20, 15, 10, false, true, showTokyo and i_Tokyo_15, 0, 0, 0, false, false)   // until 12am (Midnight)
    f_add("FPFVG Tokyo :30", 20, 30, 10, false, true, showTokyo and i_Tokyo_30, 0, 6, 0, false, false)   // until 6am
    f_add("FPFVG Tokyo :45", 20, 45, 5, false, true, showTokyo and i_Tokyo_45, 0, 0, 0, true, false)     // until 12am
    f_add("LPFVG Tokyo", 20, 45, 5, true, false, showTokyo and i_Tokyo_LP, 0, 6, 0, false, true)         // until 6am
    // --- 10pm (until 6am next day) ---
    f_add("FPFVG 10pm", 22, 0, 15, false, false, show10pm and i_10pm, 0, 6, 0, false, false)

// =====================================================================================
// 1-minute data ingestion (always 1m native, regardless of chart timeframe)
// =====================================================================================
// request.security_lower_tf THROWS A RUNTIME ERROR if the requested timeframe is not
// strictly smaller than the chart's own timeframe (e.g. asking for "1" on a 1m chart).
// So on a 1m (or lower) chart we must never call it at all — use the chart's own
// confirmed bars directly as the "1-minute" source instead.
useLTF = timeframe.in_seconds(timeframe.period) > 60

var int[]   lt_time  = array.new<int>()
var float[] lt_open  = array.new<float>()
var float[] lt_high  = array.new<float>()
var float[] lt_low   = array.new<float>()
var float[] lt_close = array.new<float>()

if useLTF
    [_t, _o, _h, _l, _c] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, high, low, close])
    lt_time := _t
    lt_open := _o
    lt_high := _h
    lt_low := _l
    lt_close := _c

var int[] hT = array.new<int>()
var float[] hO = array.new<float>()
var float[] hH = array.new<float>()
var float[] hL = array.new<float>()
var float[] hC = array.new<float>()
var int lastAppendedT = na

if useLTF
    if barstate.isconfirmed or barstate.isrealtime
        if array.size(lt_time) > 0
            for i = 0 to array.size(lt_time) - 1
                t_i = array.get(lt_time, i)
                if na(lastAppendedT) or t_i > lastAppendedT
                    array.push(hT, t_i)
                    array.push(hO, array.get(lt_open, i))
                    array.push(hH, array.get(lt_high, i))
                    array.push(hL, array.get(lt_low, i))
                    array.push(hC, array.get(lt_close, i))
                    lastAppendedT := t_i
else
    if barstate.isconfirmed
        t_i = time
        if na(lastAppendedT) or t_i > lastAppendedT
            array.push(hT, t_i)
            array.push(hO, open)
            array.push(hH, high)
            array.push(hL, low)
            array.push(hC, close)
            lastAppendedT := t_i

// trim history to bound memory (~ keep last 4000 one-minute bars, ~2.7 days)
while array.size(hT) > 4000
    array.shift(hT)
    array.shift(hO)
    array.shift(hH)
    array.shift(hL)
    array.shift(hC)

// =====================================================================================
// FVG detection helper: given a completed 1m bar index i (i>=2 in the history array),
// checks the 3-candle pattern ending at i. Returns [found, isBull, gapTop, gapBot]
// =====================================================================================
f_checkFVG(int i) =>
    h1 = array.get(hH, i - 2)
    l1 = array.get(hL, i - 2)
    h3 = array.get(hH, i)
    l3 = array.get(hL, i)
    bull = l3 > h1
    bear = h3 < l1
    gTop = bull ? l3 : bear ? h1 : na
    gBot = bull ? h1 : bear ? l3 : na
    [bull or bear, bull, gTop, gBot]

// NY-time helpers
f_hourNY(t) => hour(t, "America/New_York")
f_minNY(t) => minute(t, "America/New_York")
f_minutesOfDayNY(t) => f_hourNY(t) * 60 + f_minNY(t)

f_extTarget(int t_form, int extType, int extH, int extM) =>
    float result = na
    if extType == 1
        result := t_form + 86400000
    else if extType == 2
        result := t_form + 21 * 86400000
    else
        yr = year(t_form, "America/New_York")
        mo = month(t_form, "America/New_York")
        dy = dayofmonth(t_form, "America/New_York")
        base = timestamp("America/New_York", yr, mo, dy, extH, extM)
        formH = f_hourNY(t_form)
        base := extH <= formH ? base + 86400000 : base
        result := base
    int(result)

// =====================================================================================
// Process newly completed 1-minute bars against every session window
// =====================================================================================
newCount = array.size(hT)
var int processedUpTo = 0

if newCount >= 3 and processedUpTo < newCount
    for i = math.max(processedUpTo, 2) to newCount - 1
        [found, isBull, gTop, gBot] = f_checkFVG(i)
        if found
            t_origin = array.get(hT, i - 2)   // candle 1 (start of the pattern)
            t_confirm = array.get(hT, i)      // candle 3 (confirming candle)
            momNY = f_minutesOfDayNY(t_origin)
            gapSize = gTop - gBot

            for s = 0 to array.size(cfgs) - 1
                cfg = array.get(cfgs, s)
                st  = array.get(states, s)
                if cfg.show
                    winStart = cfg.startH * 60 + cfg.startM
                    winEnd   = winStart + cfg.winMin
                    inWin = momNY >= winStart and momNY < winEnd

                    if inWin
                        if cfg.isLast
                            // LPFVG: always take the latest one found in the window
                            st.formTime := t_origin
                            st.lastFoundTime := t_confirm
                            st.gapTop := gTop
                            st.gapBot := gBot
                            st.bull := isBull
                            st.active := true
                            st.extTarget := f_extTarget(t_origin, cfg.extType, cfg.extH, cfg.extM)
                        else
                            // FPFVG: first found wins, unless allowOverride and new gap is bigger
                            if not st.active
                                st.formTime := t_origin
                                st.gapTop := gTop
                                st.gapBot := gBot
                                st.bull := isBull
                                st.active := true
                                st.extTarget := f_extTarget(t_origin, cfg.extType, cfg.extH, cfg.extM)
                            else if cfg.allowOverride and (gTop - gBot) > (st.gapTop - st.gapBot)
                                st.formTime := t_origin
                                st.gapTop := gTop
                                st.gapBot := gBot
                                st.bull := isBull
                                st.extTarget := f_extTarget(t_origin, cfg.extType, cfg.extH, cfg.extM)

                    // Special rule: LPFVG-overrides-:45 boundary case.
                    // If this FVG forms exactly at the boundary minute (winEnd, i.e. :50)
                    // for an isFortyFive slot's PAIRED lpshared slot, and the :45 slot
                    // only ever found ONE fvg in its own window (i.e. its stored fvg
                    // is the same one the LP slot is about to also claim), let the
                    // boundary fvg replace the :45 slot's fvg as well.
                    if cfg.isLPshared and momNY == winEnd - 1
                        // find the paired :45 cfg/state (same startH/startM/winMin, isFortyFive=true)
                        for p = 0 to array.size(cfgs) - 1
                            pcfg = array.get(cfgs, p)
                            if pcfg.isFortyFive and pcfg.startH == cfg.startH and pcfg.startM == cfg.startM
                                pst = array.get(states, p)
                                sameAsForty = pst.active and st.active and pst.formTime == st.formTime
                                if sameAsForty
                                    pst.formTime := t_origin
                                    pst.gapTop := gTop
                                    pst.gapBot := gBot
                                    pst.bull := isBull
                                    pst.extTarget := f_extTarget(t_origin, pcfg.extType, pcfg.extH, pcfg.extM)
    processedUpTo := newCount

// =====================================================================================
// Rendering: draw / extend / freeze boxes
// =====================================================================================
lookAheadBars = 10

if barstate.islast or barstate.isconfirmed
    for s = 0 to array.size(cfgs) - 1
        cfg = array.get(cfgs, s)
        st  = array.get(states, s)
        if cfg.show and st.active
            rightEdgeTime = time + lookAheadBars * (time - time[1])
            capped = not na(st.extTarget) and rightEdgeTime >= st.extTarget
            drawRight = capped ? st.extTarget : rightEdgeTime

            if na(st.b)
                st.b := box.new(left=st.formTime, top=st.gapTop, right=drawRight, bottom=st.gapBot,
                     border_color=FVG_BORDER, bgcolor=FVG_COLOR, border_width=1, xloc=xloc.bar_time)
                st.lb := label.new(x=st.formTime, y=st.gapTop, text=cfg.label, style=label.style_label_down,
                     color=color.new(color.black, 100), textcolor=color.new(#eeec82, 0), size=size.tiny, xloc=xloc.bar_time)
            else
                box.set_left(st.b, st.formTime)
                box.set_top(st.b, st.gapTop)
                box.set_bottom(st.b, st.gapBot)
                box.set_right(st.b, drawRight)
                label.set_x(st.lb, st.formTime)
                label.set_y(st.lb, st.gapTop)

            if capped
                st.finalized := true

// =====================================================================================
// DEBUG TABLE — temporary, for diagnosing why nothing renders. Remove once confirmed working.
// =====================================================================================
var int dbg_barsLoaded = 0
var int dbg_fvgsFound = 0
var int dbg_sessionsActive = 0

if newCount >= 3 and processedUpTo >= newCount
    dbg_barsLoaded := newCount

if barstate.islast
    dbg_barsLoaded := array.size(hT)
    cnt = 0
    for s = 0 to array.size(states) - 1
        if array.get(states, s).active
            cnt += 1
    dbg_sessionsActive := cnt

var table dbgTbl = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast
    table.cell(dbgTbl, 0, 0, "chart tf", text_color=color.white)
    table.cell(dbgTbl, 1, 0, timeframe.period, text_color=color.white)
    table.cell(dbgTbl, 0, 1, "useLTF", text_color=color.white)
    table.cell(dbgTbl, 1, 1, str.tostring(useLTF), text_color=color.white)
    table.cell(dbgTbl, 0, 2, "1m bars loaded", text_color=color.white)
    table.cell(dbgTbl, 1, 2, str.tostring(array.size(hT)), text_color=color.white)
    table.cell(dbgTbl, 0, 3, "sessions active", text_color=color.white)
    table.cell(dbgTbl, 1, 3, str.tostring(dbg_sessionsActive), text_color=color.white)
