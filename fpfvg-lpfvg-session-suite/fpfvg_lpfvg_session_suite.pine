// @version=5
indicator("Increment 3 - Single Session (7am)", overlay=true, max_boxes_count=50)

// Same FVG detection as Increment 2, but now only the FIRST FVG whose
// origin candle falls in the NY 7:00-7:15am window gets kept and drawn
// as a plain, fixed-size box (right edge = origin + 30 bars, no dynamic
// extension/lookahead yet, no override logic yet). This is purely to
// prove the NY-time window matching works before we add complexity.

var int barCount = 0
var box sessBox = na
var bool sessActive = false
var int sessLeft = na
var float sessTop = na
var float sessBot = na

bull = false
bear = false

if barstate.isconfirmed
    barCount += 1
    if barCount >= 3
        h1 = high[2]
        l1 = low[2]
        h3 = high[0]
        l3 = low[0]
        bull := l3 > h1
        bear := h3 < l1

        if bull or bear
            originTime = time[2]
            nyH = hour(originTime, "America/New_York")
            nyM = minute(originTime, "America/New_York")
            momNY = nyH * 60 + nyM
            inWindow = momNY >= (7 * 60) and momNY < (7 * 60 + 15)

            // first FVG found anywhere in a 7:00-7:15 window wins; never resets
            if inWindow and not sessActive
                sessActive := true
                sessLeft := originTime
                sessTop := l3
                sessBot := h1
                sessBox := box.new(left=sessLeft, top=sessTop, right=sessLeft + 30 * (time - time[1]), bottom=sessBot,
                     border_color=color.new(#eeec82, 25), bgcolor=color.new(#eeec82, 80),
                     border_width=1, xloc=xloc.bar_time)

var table dbgTbl = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast
    table.cell(dbgTbl, 0, 0, "chart tf", text_color=color.white)
    table.cell(dbgTbl, 1, 0, timeframe.period, text_color=color.white)
    table.cell(dbgTbl, 0, 1, "confirmed bars seen", text_color=color.white)
    table.cell(dbgTbl, 1, 1, str.tostring(barCount), text_color=color.white)
    table.cell(dbgTbl, 0, 2, "7am session found?", text_color=color.white)
    table.cell(dbgTbl, 1, 2, str.tostring(sessActive), text_color=color.white)
