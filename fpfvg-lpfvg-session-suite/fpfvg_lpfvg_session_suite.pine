// @version=5
indicator("FPFVG / LPFVG Session Suite", overlay=true, max_boxes_count=200, max_labels_count=200, dynamic_requests=true)

// Per-individual-FVG extension override: a dropdown per slot, defaulting to "Default"
// (meaning: use that slot's own already-established extension rule, unchanged — this
// preserves every special case like 9am :30's +24h, 10am's +24h, and Tokyo's mixed
// 6am/midnight pattern exactly as before). Picking anything else overrides ONLY that one
// slot with a flat "extend N hours/days from formation" rule.
f_parseExt(sel) =>
    float result = na
    if sel != "Default"
        if str.contains(sel, "day")
            parts = str.split(sel, " ")
            n = str.tonumber(array.get(parts, 0))
            result := n * 24.0
        else
            n = str.tonumber(str.replace(sel, "h", ""))
            result := n
    result

// Scales up the PROVEN Increment 3/4 pattern (first-FVG-found-wins, per-day
// reset, dynamic 10-bar-ahead extension, freeze at cap) to all 11 "simple"
// sessions — the ones with NO override and NO shared LPFVG window.
// No 9am:15/:30/:45, 10am:15/:30/:45, Tokyo:15/:30/:45, or any LPFVG yet —
// those come in later batches.

grpMid = "Midnight"
showMidnight = input.bool(true, "Show Midnight group", group=grpMid)
i_Midnight_00 = input.bool(true, "Midnight FVG", group=grpMid)
i_Midnight_15 = input.bool(true, "Midnight :15", group=grpMid)
i_Midnight_30 = input.bool(true, "Midnight :30", group=grpMid)
i_Midnight_45 = input.bool(true, "Midnight :45", group=grpMid)
i_Midnight_LP = input.bool(true, "Midnight Last", group=grpMid)
ext_Midnight_00 = input.string("Default", "Midnight FVG Extension", options=["Default", "1h", "2h", "3h", "4h", "5h", "6h", "7h", "8h", "9h", "10h", "11h", "12h", "13h", "14h", "15h", "16h", "17h", "18h", "19h", "20h", "21h", "22h", "23h", "1 day", "2 days", "3 days", "4 days", "5 days", "6 days", "7 days"], group=grpMid)
ext_Midnight_15 = input.string("Default", "Midnight :15 Extension", options=["Default", "1h", "2h", "3h", "4h", "5h", "6h", "7h", "8h", "9h", "10h", "11h", "12h", "13h", "14h", "15h", "16h", "17h", "18h", "19h", "20h", "21h", "22h", "23h", "1 day", "2 days", "3 days", "4 days", "5 days", "6 days", "7 days"], group=grpMid)
