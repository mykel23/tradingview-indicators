type SessCfg
    string label
    int startH
    int startM
    int winMin
    bool show
    int extType   // 0 = fixed NY clock time, 1 = +24h, 2 = +21 days
    int extH
    int extM
    bool isLast    // true = LPFVG-style: always take the LATEST match in the window, not just the first
    bool allowOverride  // true = keep the biggest-gap match found within the window, not just the first
    bool isFortyFive    // true = this is a :45 tracker (gets the special :54 exception)
    bool isLPshared      // true = this is an LPFVG that shares its window with a :45 tracker
    int colorCat          // 0 = First/Last (pale gold), 1 = :30 (amber-gold), 2 = :15/:45 (bronze-gold)
    float overrideHours   // na = use extType/extH/extM as normal; otherwise extend exactly this many hours from formation

type SessState
    box b = na
    label lb = na
    line mid = na
    bool active = false
    bool finalized = false
    int day = na
    int left = na
    float top = na
    float bot = na
    float gapSize = na
    int extTarget = na

var SessCfg[] cfgs = array.new<SessCfg>()
var SessState[] states = array.new<SessState>()

f_add(_label, _sh, _sm, _win, _show, _extType, _eh, _em, _isLast, _ovr, _is45, _isLP, _cat, _ovrHrs) =>
    array.push(cfgs, SessCfg.new(_label, _sh, _sm, _win, _show, _extType, _eh, _em, _isLast, _ovr, _is45, _isLP, _cat, _ovrHrs))
    array.push(states, SessState.new())

// Standard 5-slot template for one hour: :00 (plain, no override), :15 (seeks to :25,
// override), :30 (seeks to :40, override), :45 (seeks to :50, override, gets the :54
// exception), and Last (scans :54-:59, always takes the latest). Every hour uses the
// SAME extension rule across all 5 of its own slots unless called out separately.
f_addHour(prefix, hourNum, showGrp, i00, i15, i30, i45, iLP, extType, extH, extM, ovr00, ovr15, ovr30, ovr45, ovrLP) =>
    f_add("FPFVG " + prefix, hourNum, 0, 15, showGrp and i00, extType, extH, extM, false, false, false, false, 0, ovr00)
    f_add("FPFVG " + prefix + " :15", hourNum, 15, 10, showGrp and i15, extType, extH, extM, false, true, false, false, 2, ovr15)
    f_add("FPFVG " + prefix + " :30", hourNum, 30, 10, showGrp and i30, extType, extH, extM, false, true, false, false, 1, ovr30)
    f_add("FPFVG " + prefix + " :45", hourNum, 45, 5, showGrp and i45, extType, extH, extM, false, true, true, false, 2, ovr45)
    f_add("LPFVG " + prefix, hourNum, 54, 6, showGrp and iLP, extType, extH, extM, true, false, false, true, 0, ovrLP)

if barstate.isfirst
    f_addHour("Midnight", 0, showMidnight, i_Midnight_00, i_Midnight_15, i_Midnight_30, i_Midnight_45, i_Midnight_LP, 1, 0, 0,
         f_parseExt(ext_Midnight_00), f_parseExt(ext_Midnight_15), f_parseExt(ext_Midnight_30), f_parseExt(ext_Midnight_45), f_parseExt(ext_Midnight_LP))
    f_addHour("1am", 1, show1am, i_1am_00, i_1am_15, i_1am_30, i_1am_45, i_1am_LP, 0, 10, 0,
         f_parseExt(ext_1am_00), f_parseExt(ext_1am_15), f_parseExt(ext_1am_30), f_parseExt(ext_1am_45), f_parseExt(ext_1am_LP))
    f_addHour("2am", 2, show2am, i_2am_00, i_2am_15, i_2am_30, i_2am_45, i_2am_LP, 0, 10, 0,
         f_parseExt(ext_2am_00), f_parseExt(ext_2am_15), f_parseExt(ext_2am_30), f_parseExt(ext_2am_45), f_parseExt(ext_2am_LP))
    f_addHour("3am", 3, show3am, i_3am_00, i_3am_15, i_3am_30, i_3am_45, i_3am_LP, 0, 10, 0,
         f_parseExt(ext_3am_00), f_parseExt(ext_3am_15), f_parseExt(ext_3am_30), f_parseExt(ext_3am_45), f_parseExt(ext_3am_LP))
    f_addHour("6am", 6, show6am, i_6am_00, i_6am_15, i_6am_30, i_6am_45, i_6am_LP, 0, 12, 0,
         f_parseExt(ext_6am_00), f_parseExt(ext_6am_15), f_parseExt(ext_6am_30), f_parseExt(ext_6am_45), f_parseExt(ext_6am_LP))
    f_addHour("7am", 7, show7am, i_7am_00, i_7am_15, i_7am_30, i_7am_45, i_7am_LP, 0, 10, 0,
         f_parseExt(ext_7am_00), f_parseExt(ext_7am_15), f_parseExt(ext_7am_30), f_parseExt(ext_7am_45), f_parseExt(ext_7am_LP))
    f_addHour("8am", 8, show8am, i_8am_00, i_8am_15, i_8am_30, i_8am_45, i_8am_LP, 0, 10, 0,
         f_parseExt(ext_8am_00), f_parseExt(ext_8am_15), f_parseExt(ext_8am_30), f_parseExt(ext_8am_45), f_parseExt(ext_8am_LP))
    // 9am: same as the standard template, except :30 keeps its previously-requested +24h
    // extension (a one-off exception from earlier in the build) instead of "until 10am"
    f_add("FPFVG 9am", 9, 0, 15, show9am and i_9am_00, 0, 10, 0, false, false, false, false, 0, f_parseExt(ext_9am_00))
    f_add("FPFVG 9am :15", 9, 15, 10, show9am and i_9am_15, 0, 10, 0, false, true, false, false, 2, f_parseExt(ext_9am_15))
    f_add("FPFVG 9am :30", 9, 30, 10, show9am and i_9am_30, 1, 0, 0, false, true, false, false, 1, f_parseExt(ext_9am_30))
    f_add("FPFVG 9am :45", 9, 45, 5, show9am and i_9am_45, 0, 10, 0, false, true, true, false, 2, f_parseExt(ext_9am_45))
    f_add("LPFVG 9am", 9, 54, 6, show9am and i_9am_LP, 0, 10, 0, true, false, false, true, 0, f_parseExt(ext_9am_LP))
    // 10am: same as the standard template, except :00 keeps its previously-requested
    // +24h extension instead of "until 12pm"
    f_add("FPFVG 10am", 10, 0, 15, show10am and i_10am_00, 1, 0, 0, false, false, false, false, 0, f_parseExt(ext_10am_00))
    f_add("FPFVG 10am :15", 10, 15, 10, show10am and i_10am_15, 0, 12, 0, false, true, false, false, 2, f_parseExt(ext_10am_15))
    f_add("FPFVG 10am :30", 10, 30, 10, show10am and i_10am_30, 0, 12, 0, false, true, false, false, 1, f_parseExt(ext_10am_30))
    f_add("FPFVG 10am :45", 10, 45, 5, show10am and i_10am_45, 0, 12, 0, false, true, true, false, 2, f_parseExt(ext_10am_45))
    f_add("LPFVG 10am", 10, 54, 6, show10am and i_10am_LP, 0, 12, 0, true, false, false, true, 0, f_parseExt(ext_10am_LP))
    f_addHour("6pm", 18, show6pm, i_6pm_00, i_6pm_15, i_6pm_30, i_6pm_45, i_6pm_LP, 0, 4, 0,
         f_parseExt(ext_6pm_00), f_parseExt(ext_6pm_15), f_parseExt(ext_6pm_30), f_parseExt(ext_6pm_45), f_parseExt(ext_6pm_LP))
    f_addHour("7pm", 19, show7pm, i_7pm_00, i_7pm_15, i_7pm_30, i_7pm_45, i_7pm_LP, 0, 23, 0,
         f_parseExt(ext_7pm_00), f_parseExt(ext_7pm_15), f_parseExt(ext_7pm_30), f_parseExt(ext_7pm_45), f_parseExt(ext_7pm_LP))
    // Tokyo: same as the standard template, except :00/:30/Last extend until 6am while
    // :15/:45 extend only until Midnight (previously-requested mixed extension pattern)
    f_add("FPFVG Tokyo", 20, 0, 15, showTokyo and i_Tokyo_00, 0, 6, 0, false, false, false, false, 0, f_parseExt(ext_Tokyo_00))
    f_add("FPFVG Tokyo :15", 20, 15, 10, showTokyo and i_Tokyo_15, 0, 0, 0, false, true, false, false, 2, f_parseExt(ext_Tokyo_15))
    f_add("FPFVG Tokyo :30", 20, 30, 10, showTokyo and i_Tokyo_30, 0, 6, 0, false, true, false, false, 1, f_parseExt(ext_Tokyo_30))
    f_add("FPFVG Tokyo :45", 20, 45, 5, showTokyo and i_Tokyo_45, 0, 0, 0, false, true, true, false, 2, f_parseExt(ext_Tokyo_45))
    f_add("LPFVG Tokyo", 20, 54, 6, showTokyo and i_Tokyo_LP, 0, 6, 0, true, false, false, true, 0, f_parseExt(ext_Tokyo_LP))
    f_addHour("10pm", 22, show10pm, i_10pm_00, i_10pm_15, i_10pm_30, i_10pm_45, i_10pm_LP, 0, 6, 0,
         f_parseExt(ext_10pm_00), f_parseExt(ext_10pm_15), f_parseExt(ext_10pm_30), f_parseExt(ext_10pm_45), f_parseExt(ext_10pm_LP))

var int barCount = 0
bull = false
bear = false

// FVG detection must always run on TRUE 1-minute data, regardless of the chart's own
// timeframe. Three cases:
//   - chart coarser than 1m (5m, 15m, ...): pull real 1-minute intrabars via
//     request.security_lower_tf
//   - chart exactly 1m: use the chart's own bars directly
//   - chart finer than 1m (30s, 15s, ...): use the chart's own bars, but AGGREGATE them
//     into real 1-minute buckets ourselves (floor each bar's time to the minute, merge
//     high/low until the minute rolls over) rather than treating each sub-minute bar as
//     if it were its own full 1-minute candle
chartTFSeconds = timeframe.in_seconds(timeframe.period)
useLTF = chartTFSeconds > 60
subMinute = chartTFSeconds > 0 and chartTFSeconds < 60

var int[]   lt_time  = array.new<int>()
var float[] lt_high  = array.new<float>()
var float[] lt_low   = array.new<float>()

if useLTF
    [_t, _h, _l] = request.security_lower_tf(syminfo.tickerid, "1", [time, high, low])
    lt_time := _t
    lt_high := _h
    lt_low := _l

var int[]   hT = array.new<int>()
var float[] hH = array.new<float>()
var float[] hL = array.new<float>()
var int lastAppendedT = na

var float bucketHigh = na
var float bucketLow  = na
var int   bucketMinute = na

if useLTF
    if barstate.isconfirmed or barstate.isrealtime
        // TradingView's request.security_lower_tf can silently fall back to returning
        // just the CHART bar's own OHLC as a single "intrabar" when true 1-minute data
        // isn't available that far back in history — which would masquerade as a real
        // 1-minute bar and badly distort FVG detection (5m-sized gaps instead of 1m).
        // A reliable real pull on a 5m chart should return close to 5 intrabars per
        // closed bar; if we get suspiciously few, treat this bar's data as unusable
        // and skip it entirely rather than risk feeding in a disguised 5m candle.
        expectedIntrabars = math.round(timeframe.in_seconds(timeframe.period) / 60.0)
        looksReal = array.size(lt_time) >= math.max(2, expectedIntrabars - 1)
        if looksReal
            for i = 0 to array.size(lt_time) - 1
                t_i = array.get(lt_time, i)
                if na(lastAppendedT) or t_i > lastAppendedT
                    array.push(hT, t_i)
                    array.push(hH, array.get(lt_high, i))
                    array.push(hL, array.get(lt_low, i))
                    lastAppendedT := t_i
else if subMinute
    // aggregate the chart's own sub-1-minute bars into real 1-minute buckets. A bucket is
    // only pushed to the history once we see a bar belonging to the NEXT minute — meaning
    // the previous bucket is now genuinely complete.
    if barstate.isconfirmed
        thisMinute = int(math.floor(time / 60000.0))
        if na(bucketMinute)
            bucketMinute := thisMinute
            bucketHigh := high
            bucketLow := low
        else if thisMinute == bucketMinute
            bucketHigh := math.max(bucketHigh, high)
            bucketLow := math.min(bucketLow, low)
        else
            completedT = int(bucketMinute * 60000)
            if na(lastAppendedT) or completedT > lastAppendedT
                array.push(hT, completedT)
                array.push(hH, bucketHigh)
                array.push(hL, bucketLow)
                lastAppendedT := completedT
            bucketMinute := thisMinute
            bucketHigh := high
            bucketLow := low
else
    if barstate.isconfirmed
        t_i = time
        if na(lastAppendedT) or t_i > lastAppendedT
            array.push(hT, t_i)
            array.push(hH, high)
            array.push(hL, low)
            lastAppendedT := t_i

var int processedUpTo = 0

while array.size(hT) > 4000
    array.shift(hT)
    array.shift(hH)
    array.shift(hL)
    // the cursor tracking how far we've already processed must shift down by the same
    // amount, or it silently desyncs from the array's real indices once trimming starts —
    // which halts all future detection once enough history accumulates (~2.7 days)
    processedUpTo := math.max(0, processedUpTo - 1)

newCount = array.size(hT)

if newCount >= 3 and processedUpTo < newCount
    for idx = math.max(processedUpTo, 2) to newCount - 1
        barCount += 1
        h1 = array.get(hH, idx - 2)
        l1 = array.get(hL, idx - 2)
        h3 = array.get(hH, idx)
        l3 = array.get(hL, idx)
        t1chk = array.get(hT, idx - 2)
        t3chk = array.get(hT, idx)
        // guard against gaps in the 1m sequence (e.g. from the reliability filter above,
        // or an overnight/weekend break): only treat this as a valid 3-candle pattern if
        // candle 1 and candle 3 are genuinely exactly 2 minutes apart
        isAdjacent = (t3chk - t1chk) == 120000
        // require more than 5 ticks of actual gap — anything smaller is noise, not a real FVG
        rawBull = isAdjacent and l3 > h1
        rawBear = isAdjacent and h3 < l1
        rawGapSize = rawBull ? (l3 - h1) : rawBear ? (l1 - h3) : 0.0
        meetsMinGap = rawGapSize > syminfo.mintick * 5
        bull := rawBull and meetsMinGap
        bear := rawBear and meetsMinGap

        if bull or bear
            originTime = array.get(hT, idx - 2)   // candle 1 — used only for the box's visual left edge
            midTime = array.get(hT, idx - 1)      // candle 2 (the displacement candle) — this is what
                                                    // actually anchors which time-window a gap belongs to,
                                                    // matching the convention from the dealing range script
            nyH = hour(midTime, "America/New_York")
            nyM = minute(midTime, "America/New_York")
            nyY = year(midTime, "America/New_York")
            nyMo = month(midTime, "America/New_York")
            nyD = dayofmonth(midTime, "America/New_York")
            dayKey = nyY * 372 + nyMo * 31 + nyD
            momNY = nyH * 60 + nyM
            gTop = bull ? l3 : l1
            gBot = bull ? h1 : h3
            gapSizeNow = gTop - gBot

            for s = 0 to array.size(cfgs) - 1
                cfg = array.get(cfgs, s)
                st = array.get(states, s)
                if cfg.show
                    winStart = cfg.startH * 60 + cfg.startM
                    winEnd = winStart + cfg.winMin
                    inWin = momNY >= winStart and momNY < winEnd
                    isNewDay = na(st.day) or dayKey != st.day

                    shouldTake = false
                    if inWin
                        if isNewDay
                            shouldTake := true
                        else if not st.active
                            shouldTake := true
                        else if cfg.isLast
                            shouldTake := true
                        else if cfg.allowOverride and gapSizeNow > st.gapSize
                            shouldTake := true

                    if shouldTake
                        // if we're replacing an existing box (LPFVG overwrite or a
                        // bigger-displacement override within the same day), delete the
                        // old drawing first so it doesn't linger
                        if st.active and not isNewDay and not na(st.b)
                            box.delete(st.b)
                            line.delete(st.mid)
                            label.delete(st.lb)
                        st.active := true
                        st.finalized := false
                        st.day := dayKey
                        st.left := originTime
                        st.top := gTop
                        st.bot := gBot
                        st.gapSize := gapSizeNow
                        st.b := na
                        // extension target — a per-slot override takes priority over the
                        // hour's normal default extension rule entirely
                        if not na(cfg.overrideHours)
                            st.extTarget := originTime + int(cfg.overrideHours * 3600000)
                        else if cfg.extType == 1
                            st.extTarget := originTime + 86400000
                        else if cfg.extType == 2
                            st.extTarget := originTime + 21 * 86400000
                        else
                            base = timestamp("America/New_York", nyY, nyMo, nyD, cfg.extH, cfg.extM)
                            st.extTarget := cfg.extH <= nyH ? base + 86400000 : base

                    // Exception: for the :45 trackers specifically, a bigger-displacement
                    // FVG whose origin lands exactly at :54 overrides the :45 pick even
                    // though it's outside the normal 45-50 seek window. But :54 is also
                    // where LPFVG's own window (54-59) begins — so whenever the paired
                    // LPFVG tracker is enabled, we defer to it entirely (it'll naturally
                    // claim that same candle via its own window logic below, and gets the
                    // "Last" label). This override only fires as a fallback when LPFVG is
                    // toggled off for that hour.
                    if cfg.isFortyFive and not isNewDay and st.day == dayKey
                        is54 = momNY == (cfg.startH * 60 + 54)
                        if is54 and (not st.active or gapSizeNow > st.gapSize)
                            lpEnabled = false
                            for p = 0 to array.size(cfgs) - 1
                                pcfg = array.get(cfgs, p)
                                if pcfg.isLPshared and pcfg.startH == cfg.startH and pcfg.show
                                    lpEnabled := true
                            if not lpEnabled
                                if st.active and not na(st.b)
                                    box.delete(st.b)
                                    line.delete(st.mid)
                                    label.delete(st.lb)
                                st.active := true
                                st.finalized := false
                                st.day := dayKey
                                st.left := originTime
                                st.top := gTop
                                st.bot := gBot
                                st.gapSize := gapSizeNow
                                st.b := na
                                if not na(cfg.overrideHours)
                                    st.extTarget := originTime + int(cfg.overrideHours * 3600000)
                                else if cfg.extType == 1
                                    st.extTarget := originTime + 86400000
                                else if cfg.extType == 2
                                    st.extTarget := originTime + 21 * 86400000
                                else
                                    base2 = timestamp("America/New_York", nyY, nyMo, nyD, cfg.extH, cfg.extM)
                                    st.extTarget := cfg.extH <= nyH ? base2 + 86400000 : base2
    processedUpTo := newCount

lookAheadBars = 10
labelGap = 3   // small time-gap so label text doesn't touch the line, same convention as the dealing range script
gapMs = labelGap * timeframe.in_seconds(timeframe.period) * 1000

// color categories: 0 = First/Last (pale gold, dark text), 1 = :30 (amber-gold), 2 = :15/:45 (bronze-gold)
f_boxColor(cat) => cat == 1 ? #f0c419 : cat == 2 ? #d4a017 : #eeec82
f_textColor(cat) => cat == 0 ? f_boxColor(cat) : cat == 1 ? #a8790a : f_boxColor(cat)

if barstate.isconfirmed or barstate.isrealtime
    for s = 0 to array.size(cfgs) - 1
        cfg = array.get(cfgs, s)
        st = array.get(states, s)
        if cfg.show and st.active and not st.finalized
            rightEdge = time + lookAheadBars * (time - time[1])
            capped = not na(st.extTarget) and rightEdge >= st.extTarget
            drawRight = capped ? st.extTarget : rightEdge
            midPrice = (st.top + st.bot) / 2
            boxCol = f_boxColor(cfg.colorCat)
            txtCol = f_textColor(cfg.colorCat)

            if na(st.b)
                st.b := box.new(left=st.left, top=st.top, right=drawRight, bottom=st.bot,
                     border_color=color.new(boxCol, 25), bgcolor=color.new(boxCol, 80),
                     border_width=1, xloc=xloc.bar_time)
                st.mid := line.new(x1=st.left, y1=midPrice, x2=drawRight, y2=midPrice,
                     color=color.new(boxCol, 25), style=line.style_dashed, width=1, xloc=xloc.bar_time)
                st.lb := label.new(x=drawRight + gapMs, y=midPrice, text=cfg.label, style=label.style_label_left,
                     color=color.new(color.black, 100), textcolor=color.new(txtCol, 0), size=size.small, xloc=xloc.bar_time)
            else
                box.set_right(st.b, drawRight)
                line.set_x2(st.mid, drawRight)
                label.set_x(st.lb, drawRight + gapMs)

            if capped
                st.finalized := true
